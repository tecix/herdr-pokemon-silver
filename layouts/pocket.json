{
  "id": "root",
  "type": "column",
  "theme": {
    "light": "pocket-light",
    "dark": "pocket"
  },
  "font": "JetBrains Mono",
  "font_size": 14,
  "ui_font": "Galmuri11",
  "terminal_padding": [
    8,
    6
  ],
  "terminal_opacity": 1,
  "titlebar": "none",
  "traffic_lights": [
    12,
    9
  ],
  "background": "canvas",
  "preview": "layouts/pocket.svg",
  "children": [
    {
      "id": "bar",
      "type": "block",
      "size": {
        "px": 34
      },
      "window_drag": true,
      "content": {
        "mod": "pocket",
        "props": {
          "role": "bar"
        }
      }
    },
    {
      "id": "screen",
      "type": "row",
      "gap": 8,
      "padding": [
        0,
        8
      ],
      "children": [
        {
          "id": "sidebar",
          "type": "block",
          "size": {
            "px": 300
          },
          "min": 160,
          "max": 460,
          "content": {
            "mod": "pocket",
            "props": {
              "role": "party"
            }
          }
        },
        {
          "id": "main",
          "type": "block",
          "content": {
            "tab": "active",
            "pane": {
              "gap": 8,
              "radius": 4,
              "background": "background",
              "border": {
                "width": 2,
                "color": "border"
              },
              "focus": {
                "width": 2,
                "color": "accent"
              },
              "header": {
                "content": {
                  "mod": "pocket",
                  "props": {
                    "role": "header"
                  }
                },
                "height": 30,
                "position": "top",
                "reveal": "always"
              },
              "lone": true
            }
          }
        }
      ]
    },
    {
      "id": "bottom",
      "type": "row",
      "size": {
        "px": 124
      },
      "min": 80,
      "max": 400,
      "gap": 0,
      "children": [
        {
          "id": "field",
          "type": "block",
          "padding": [
            8,
            8
          ],
          "content": {
            "mod": "pocket",
            "props": {
              "role": "field"
            }
          }
        },
        {
          "id": "dialog",
          "type": "block",
          "size": {
            "px": 520
          },
          "padding": [
            8,
            8
          ],
          "content": {
            "mod": "pocket",
            "props": {
              "role": "dialog"
            }
          },
          "min": 320,
          "max": 900
        }
      ]
    }
  ]
}